# Generate each independently with: openssl rand -hex 32
# The vault key encrypts tokens and the derived mailbox key password at rest.
# Back it up separately from the vault. Never rotate it by replacing this value.
PROTON_VAULT_KEY=
MCP_BEARER_TOKEN=

# Empty/unset allows all account calendars, including calendars added later.
# Optional restriction: comma-separated exact IDs from the calendars command, not names.
PROTON_CALENDAR_IDS=
PROTON_TIMEZONE=Europe/Kyiv

# Exact incoming Host values. Add your Dokploy domain (without https://).
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,proton-calendar-mcp:8080,proton-calendar-mcp:8081

# Only needed with docker-compose.tunnel.yml.
MCP_TUNNEL_TOKEN=
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
